# Matrix Automation & Control — Apache config for cPanel
#
# Layout of public_html after a deploy (see scripts/prerender.mjs):
#   index.html                    Home page snapshot
#   products/index.html           /products snapshot (also the folder for product snapshots)
#   products/<slug>/index.html    one snapshot per published product
#   brands/..., contact/... etc.  the other pages
#   200.html                      the plain app shell, for every URL that has no snapshot
#   assets/                       JS/CSS bundles
# Snapshots are only a first paint; the app then loads live data from Supabase.

DirectoryIndex index.html

# Pages are now real folders (/products/ is a folder AND a page). Without this, Apache would
# redirect /products to /products/ — we never want trailing-slash URLs.
DirectorySlash Off

# The FTP deploy action keeps its file list here — nobody else needs to see it.
<Files ".ftp-deploy-sync-state.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. One URL per page: /products/ -> /products (301, query string kept). Not for the root "/".
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # 3. Real files are served as-is (assets, images, robots.txt, sitemap.xml, the snapshots
  #    themselves once rule 5 has rewritten to them, ...).
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 3b. A missing code/style file is a real 404 — never the app shell. (After a deploy, old hashed
  #     files are gone: an HTML page served as JavaScript would crash the page, and could even be
  #     cached for a year under the /assets/ rule below. A clean 404 lets the app reload itself.)
  RewriteRule ^assets/ - [R=404,L]

  # 4. Home page snapshot.
  RewriteRule ^$ /index.html [L]

  # 5. Page snapshot: /products/abc -> /products/abc/index.html, if that file exists.
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^ %{REQUEST_URI}/index.html [L]

  # 6. Everything else (e.g. a product added after the last build, or a 404) gets the app shell.
  #    NOT index.html — that is now the Home snapshot.
  RewriteRule ^ /200.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed build files in /assets/ never change -> cache for a year.
  # (<FilesMatch> only sees the file name, never the folder, so it can't match "assets/".)
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # The HTML (snapshots and 200.html) and logo-boxes.json must always be fresh so new deploys
  # show up immediately
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
